<Window x:Class="WordlePL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wordle po polsku"
        Width="520" Height="720"
        MinWidth="420" MinHeight="620"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        Focusable="True">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Nagłówek -->
            <RowDefinition Height="Auto"/>
            <!-- Plansza -->
            <RowDefinition Height="*"/>
            <!-- Klawiatura -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ NAGŁÓWEK ═══════════ -->
        <Border Grid.Row="0" BorderBrush="#272729" BorderThickness="0,0,0,1" Padding="0,4,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Przycisk pomocy -->
                <Button Grid.Column="0" Content="?" Width="34" Height="34"
                        FontWeight="Bold" FontSize="14"
                        Background="#272729" Foreground="{StaticResource TextBrush}"
                        BorderThickness="0"
                        Click="HelpButton_Click"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="17"
                                    Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Tytuł -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="W O R D L E " FontSize="22" FontWeight="ExtraBold" 
                               Foreground="{StaticResource TextBrush}"/>
                    <Border Background="#e0245e" CornerRadius="4" Padding="5,1,5,2" VerticalAlignment="Center">
                        <TextBlock Text="PL" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <!-- Streak -->
                <Border Grid.Column="2" Background="#272729" CornerRadius="14" Padding="10,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔥 " FontSize="14"/>
                        <TextBlock x:Name="StreakText" Text="0" FontSize="14" FontWeight="Bold"
                                   Foreground="#ff9f1c" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════ PLANSZA GRY (6×5) ═══════════ -->
        <Grid Grid.Row="1" x:Name="BoardGrid"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Width="310" Height="370" Margin="0,10">
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/>
                <RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                <ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!-- Kafelki generowane w code-behind -->
        </Grid>

        <!-- Powiadomienie Toast (np. "Nie ma takiego słowa", "Za mało liter") -->
        <Border x:Name="ToastBorder" Grid.Row="1"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,8,0,0"
                Background="#f8f9fa"
                CornerRadius="6"
                Padding="16,8"
                Opacity="0"
                IsHitTestVisible="False"
                Panel.ZIndex="100">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <TextBlock x:Name="ToastText" Text="Nie ma takiego słowa"
                       Foreground="#121213" FontWeight="Bold" FontSize="14"/>
        </Border>

        <!-- ═══════════ KLAWIATURA WIRTUALNA ═══════════ -->
        <StackPanel Grid.Row="2" x:Name="KeyboardPanel" Margin="0,6,0,4">
            <!-- Wiersze klawiatury generowane w code-behind -->
        </StackPanel>
    </Grid>
</Window>
